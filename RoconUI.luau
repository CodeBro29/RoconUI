--!strict
local RoconUI = {}

function RoconUI.new(Icon: string, Color: Color3?, Size: number?) : string?
	if Icon == "verified-blue-filled" then
		return utf8.char(0xE000)
	end
	
	local CamelCase = string.sub(Icon,1,1)
	
	for i=2,string.len(Icon) do 
		if string.len(Icon)  >= i then
			if string.sub(Icon, i, i) == "-" then continue end
			if string.sub(Icon, i-1, i-1) == "-" then
				CamelCase = CamelCase..string.upper(string.sub(Icon,i,i))
				continue
			end
			
			CamelCase = CamelCase..string.sub(Icon,i,i)
		end
	end
		
	if not RoconUI.Rocons[CamelCase] then
		warn(`Rocon {CamelCase} could not be found.`)
        return nil
    end

    local Filled = string.find(string.lower(Icon), "-filled")

	return `<font family="rbxasset://LuaPackages/Packages/_Index/BuilderIcons/BuilderIcons/BuilderIcons.json" {Color and `color="rgb({math.round(Color.R*255*10)/10},{math.round(Color.G*255*10)/10},{math.round(Color.B*255*10)/10})"` or ""} {Size and `size="{Size}"` or ""}>{Filled and `<b>{Icon}</b>` or Icon}</font>`
end

